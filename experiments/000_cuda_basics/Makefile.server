# Makefile for the linux server with NVIDIA and AMD GPU

NVCC ?= nvcc
HIPCC ?= hipcc
HIPIFY ?= hipify-perl

NVCC_FLAGS ?= -std=c++17 -O2
HIPCC_FLAGS ?= -std=c++17 -O2

BIN_DIR ?= bin_server
HIPIFY_DIR = hipify_generated

# AMD Radeon RX 7700 XT architecture = gfx1101 , gpu_id = 0
# AMD Radeon Graphics = gfx1036 , gpu_id = 1
AMD_ARCH ?= gfx1036
HIP_GPU_ID ?= 1


ROCM_LIB = /opt/rocm/lib
CUDA_LIB = /usr/local/cuda/lib64


CUDA_HELLO_SRC = cuda/hello.cu
CUDA_HELLO_BIN = $(BIN_DIR)/hello_cuda

CUDA_ADD_SRC = cuda/unified_add.cu
CUDA_ADD_BIN = $(BIN_DIR)/unified_add_cuda

HIP_HELLO_SRC = $(HIPIFY_DIR)/hello.hip.cpp
HIP_ADD_SRC = $(HIPIFY_DIR)/unified_add.hip.cpp

HIP_HELLO_NVIDIA_BIN = $(BIN_DIR)/hello_hip_nvidia
HIP_ADD_NVIDIA_BIN = $(BIN_DIR)/unified_add_hip_nvidia

HIP_HELLO_AMD_BIN = $(BIN_DIR)/hello_hip_amd
HIP_ADD_AMD_BIN = $(BIN_DIR)/unified_add_hip_amd


CUDA_MATMUL_SRC = cuda/matmul.cu
CUDA_MATMUL_BIN = $(BIN_DIR)/matmul_cuda
HIP_MATMUL_SRC = $(HIPIFY_DIR)/matmul.hip.cpp
HIP_MATMUL_NVIDIA_BIN = $(BIN_DIR)/matmul_hip_nvidia
HIP_MATMUL_AMD_BIN = $(BIN_DIR)/matmul_hip_amd



.PHONY: all cuda hipify hip hip-nvidia hip-amd run-cuda run-hello run-add run-matmul run-hip run-hip-nvidia run-hip-amd clean

all: cuda hip-amd

cuda: $(CUDA_HELLO_BIN) $(CUDA_ADD_BIN) $(CUDA_MATMUL_BIN)

hipify: $(HIP_HELLO_SRC) $(HIP_ADD_SRC) $(HIP_MATMUL_SRC)

hip: hip-nvidia

hip-nvidia: $(HIP_HELLO_NVIDIA_BIN) $(HIP_ADD_NVIDIA_BIN) $(HIP_MATMUL_NVIDIA_BIN)

hip-amd: $(HIP_HELLO_AMD_BIN) $(HIP_ADD_AMD_BIN) $(HIP_MATMUL_AMD_BIN)



$(CUDA_HELLO_BIN): $(CUDA_HELLO_SRC)
	mkdir -p $(BIN_DIR)
	$(NVCC) $(NVCC_FLAGS) $(CUDA_HELLO_SRC) -o $(CUDA_HELLO_BIN)

$(CUDA_ADD_BIN): $(CUDA_ADD_SRC)
	mkdir -p $(BIN_DIR)
	$(NVCC) $(NVCC_FLAGS) $(CUDA_ADD_SRC) -o $(CUDA_ADD_BIN)

$(CUDA_MATMUL_BIN): $(CUDA_MATMUL_SRC)
	mkdir -p $(BIN_DIR)
	$(NVCC) $(NVCC_FLAGS) $(CUDA_MATMUL_SRC) -o $(CUDA_MATMUL_BIN)



$(HIP_HELLO_SRC): $(CUDA_HELLO_SRC)
	mkdir -p $(HIPIFY_DIR)
	$(HIPIFY) $(CUDA_HELLO_SRC) > $(HIP_HELLO_SRC)

$(HIP_ADD_SRC): $(CUDA_ADD_SRC)
	mkdir -p $(HIPIFY_DIR)
	$(HIPIFY) $(CUDA_ADD_SRC) > $(HIP_ADD_SRC)

$(HIP_MATMUL_SRC): $(CUDA_MATMUL_SRC)
	mkdir -p $(HIPIFY_DIR)
	$(HIPIFY) $(CUDA_MATMUL_SRC) > $(HIP_MATMUL_SRC)


$(HIP_HELLO_NVIDIA_BIN): $(HIP_HELLO_SRC)
	mkdir -p $(BIN_DIR)
	$(HIPCC) $(HIPCC_FLAGS) $(HIP_HELLO_SRC) -o $(HIP_HELLO_NVIDIA_BIN)

$(HIP_ADD_NVIDIA_BIN): $(HIP_ADD_SRC)
	mkdir -p $(BIN_DIR)
	$(HIPCC) $(HIPCC_FLAGS) $(HIP_ADD_SRC) -o $(HIP_ADD_NVIDIA_BIN)

$(HIP_MATMUL_NVIDIA_BIN): $(HIP_MATMUL_SRC)
	mkdir -p $(BIN_DIR)
	$(HIPCC) $(HIPCC_FLAGS) $(HIP_MATMUL_SRC) -o $(HIP_MATMUL_NVIDIA_BIN)

$(HIP_HELLO_AMD_BIN): $(HIP_HELLO_SRC)
	mkdir -p $(BIN_DIR)
	$(HIPCC) $(HIPCC_FLAGS) --offload-arch=$(AMD_ARCH) $(HIP_HELLO_SRC) -o $(HIP_HELLO_AMD_BIN)

$(HIP_ADD_AMD_BIN): $(HIP_ADD_SRC)
	mkdir -p $(BIN_DIR)
	$(HIPCC) $(HIPCC_FLAGS) --offload-arch=$(AMD_ARCH) $(HIP_ADD_SRC) -o $(HIP_ADD_AMD_BIN)

$(HIP_MATMUL_AMD_BIN): $(HIP_MATMUL_SRC)
	mkdir -p $(BIN_DIR)
	$(HIPCC) $(HIPCC_FLAGS) --offload-arch=$(AMD_ARCH) $(HIP_MATMUL_SRC) -o $(HIP_MATMUL_AMD_BIN)


run-cuda: cuda
	LD_LIBRARY_PATH=$(CUDA_LIB):$$LD_LIBRARY_PATH ./$(CUDA_HELLO_BIN)
	LD_LIBRARY_PATH=$(CUDA_LIB):$$LD_LIBRARY_PATH ./$(CUDA_ADD_BIN)
	LD_LIBRARY_PATH=$(CUDA_LIB):$$LD_LIBRARY_PATH ./$(CUDA_MATMUL_BIN)

run-hello: $(CUDA_HELLO_BIN)
	LD_LIBRARY_PATH=$(CUDA_LIB):$$LD_LIBRARY_PATH ./$(CUDA_HELLO_BIN)

run-add: $(CUDA_ADD_BIN)
	LD_LIBRARY_PATH=$(CUDA_LIB):$$LD_LIBRARY_PATH ./$(CUDA_ADD_BIN)

run-hip: run-hip-nvidia

run-hip-nvidia: hip-nvidia
	LD_LIBRARY_PATH=$(CUDA_LIB):$$LD_LIBRARY_PATH ./$(HIP_HELLO_NVIDIA_BIN)
	LD_LIBRARY_PATH=$(CUDA_LIB):$$LD_LIBRARY_PATH ./$(HIP_ADD_NVIDIA_BIN)
	LD_LIBRARY_PATH=$(CUDA_LIB):$$LD_LIBRARY_PATH ./$(HIP_MATMUL_NVIDIA_BIN)

run-hip-amd: hip-amd
	env HIP_VISIBLE_DEVICES=$(HIP_GPU_ID) LD_LIBRARY_PATH=$(ROCM_LIB) ./$(HIP_HELLO_AMD_BIN)
	env HIP_VISIBLE_DEVICES=$(HIP_GPU_ID) LD_LIBRARY_PATH=$(ROCM_LIB) ./$(HIP_ADD_AMD_BIN)
	env HIP_VISIBLE_DEVICES=$(HIP_GPU_ID) LD_LIBRARY_PATH=$(ROCM_LIB) ./$(HIP_MATMUL_AMD_BIN)
	
clean:
	rm -rf $(BIN_DIR)